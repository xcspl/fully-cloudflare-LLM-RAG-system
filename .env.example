# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# LLM provider via AI Gateway
# Gateway URL: https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_name}
LLM_BASE_URL=
LLM_PROVIDER=custom-minimax
LLM_MODEL=                   # e.g. "MiniMax-M2.7"
LLM_API_MODE=openai          # "openai" | "anthropic"

# Canonicalization LLM (for /ingest — same gateway, different provider)
CANON_PROVIDER=custom-deep2
CANON_MODEL=deepseek-v4-flash

# For Python ingest scripts (Data Worker URL)
DATA_WORKER_URL=

# Worker secrets (set via: wrangler secret put)
# CF_AIG_TOKEN (AI Gateway token for cf-aig-authorization header)
# ADMIN_TOKEN (for Data Worker /delete endpoint)
