# Cloudflare
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AIG_TOKEN=                # Gateway token for cf-aig-authorization header
WORKER_URL=                  # https://gaia.<subdomain>.workers.dev (set after deploy)

# LLM provider via AI Gateway (also set in wrangler.toml [vars])
# Streams responses via SSE by default (stream: true in request body)
LLM_BASE_URL=                # https://gateway.ai.cloudflare.com/v1/{account}/{gateway}
LLM_PROVIDER=custom-minimax
LLM_MODEL=                   # e.g. "MiniMax-M2.7"
LLM_API_MODE=openai          # "openai" | "anthropic"

# Canonicalization LLM (for /ingest — same gateway, different provider slug + model)
CANON_PROVIDER=custom-deep2
CANON_MODEL=deepseek-v4-flash

# Worker secrets (set via: wrangler secret put)
# CF_AIG_TOKEN
