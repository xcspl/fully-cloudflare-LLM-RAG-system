# Cloudflare
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AI_GATEWAY_ID=             # Set after creating gateway
CF_AI_GATEWAY_TOKEN=          # Gateway auth token (may be same as CF_API_TOKEN)

# LLM provider (chat inference)
LLM_API_KEY=                  # Provider API key (Minimax)
LLM_BASE_URL=                 # Gateway URL: https://gateway.ai.cloudflare.com/v1/{account}/{gateway}/custom-minimax/v1

# Canonicalization LLM (for ingest pipeline)
# Can be the same or different from the chat LLM
CANON_LLM_API_KEY=
CANON_LLM_BASE_URL=

# Worker secrets (set via: wrangler secret put LLM_API_KEY)
# CF_AI_GATEWAY_TOKEN — also set via wrangler secret
